<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-langchain4j</artifactId>
  <packaging>jar</packaging>

  <!-- langchain4j chat-model provider backed by jinfer: in-process CPU inference over GGUF models,
       native chat-template codec first (token-exact, injection-inert), hardened Jinja whole-render
       fallback for unported models. Blocking + streaming, tools, reasoning lane. Runtime needs
       jinfer's JVM flags: enable-preview, jdk.incubator.vector, enable-native-access.

       Named jinfer-langchain4j, NOT langchain4j-jinfer: the langchain4j- prefix belongs to modules
       released by that project (dev.langchain4j / dev.langchain4j.community), and wearing it under
       com.qxotic would read on Maven Central as an official integration. It flips only if this is
       ever upstreamed. Same convention as jinfer-spring-ai. -->
  <name>jinfer-langchain4j</name>
  <description>LangChain4j provider for fast, local, in-process LLM inference on the JVM. No
    server, no HTTP, no external processes. Chat, embeddings, scoring, and speech. End to end in
    Java.</description>

  <properties>
    <langchain4j.version>1.18.0</langchain4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <!-- AiServices (the tool-loop showcase); tests only - the provider itself needs just -core -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <version>${langchain4j.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the compliance kit: AbstractChatModelIT and friends (test-jar) + its assertion deps -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
      <version>${langchain4j.version}</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the chat path: the engine, its cache and the JSON codec Mappings speaks -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-codecs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <!-- the model cache behind .model(String): path, hub ref or URL, one resolver. Only the
         builders touch it - nothing on an inference path ever resolves or downloads. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-hub</artifactId>
    </dependency>
    <!-- every architecture provider, as ServiceLoader cargo: ONE list to maintain, in
         jinfer-models-all. Runtime scope lands it on the test classpath too, so the ITs
         double as the smoke test that the aggregation carries every family. A shaded consumer
         needs the ServicesResourceTransformer. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-models-all</artifactId>
      <type>pom</type>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- Stable JPMS name, reserved without committing to module-info.java yet. -->
              <Automatic-Module-Name>com.qxotic.jinfer.langchain4j</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
