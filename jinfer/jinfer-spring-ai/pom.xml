<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-spring-ai</artifactId>
  <packaging>jar</packaging>

  <name>Jinfer Spring AI Provider</name>
  <description>Spring AI provider for local LLM inference inside the JVM. Supports chat,
    streaming, embeddings, reranking, tools, multimodal input, and speech.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>
    <!-- the post-retrieval seam (DocumentPostProcessor, Query): Spring AI models reranking as a
         RAG pipeline step, not as a model type -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-rag</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- the chat path: the engine, its cache, and the JSON codec Mappings speaks -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-codecs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <!-- the model cache behind remote model and companion refs. Only the builders touch it -
         nothing on an inference path ever resolves or downloads. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-hub</artifactId>
    </dependency>
    <!-- Exercise every architecture in this module's integration tests. Applications choose
         jinfer-models-all or individual providers explicitly. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-models-all</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- E2E proof that the type-seam framing makes a single-bean VectorStore retrieval-correct -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-vector-store</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- observation assertions; matches spring-ai-model's micrometer-observation -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-observation-test</artifactId>
      <version>${micrometer.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- ChatClient for the structured-output entity() dogfood -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- Stable JPMS name, reserved without committing to module-info.java yet. -->
              <Automatic-Module-Name>com.qxotic.jinfer.spring.ai</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
