<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-spring-ai</artifactId>
  <packaging>jar</packaging>

  <!-- Spring AI chat-model provider backed by jinfer: in-process CPU
       inference over GGUF models, native chat-template codec first (token-exact, injection-inert),
       hardened Jinja whole-render fallback for unported models. Blocking + streaming, tools,
       media, embeddings, reranking, speech. Runtime needs jinfer's JVM flags: enable-preview,
       jdk.incubator.vector, enable-native-access.

       Named jinfer-spring-ai, NOT spring-ai-jinfer: the spring-ai- prefix belongs to
       modules released by that project, and wearing it under com.qxotic would read on Maven
       Central as an official integration. Same convention as jinfer-langchain4j. -->
  <name>jinfer-spring-ai</name>
  <description>Spring AI provider for fast, local, in-process LLM inference on the JVM. No
    server, no HTTP, no external processes. Chat, embeddings, document reranking, and
    text-to-speech. End to end in Java.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>
    <!-- the post-retrieval seam (DocumentPostProcessor, Query): Spring AI models reranking as a
         RAG pipeline step, not as a model type -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-rag</artifactId>
    </dependency>
    <!-- the chat path: the engine, its cache, and the JSON codec Mappings speaks -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-codecs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <!-- the model cache behind .model(String): path, hub ref or URL, one resolver. Only the
         builders touch it - nothing on an inference path ever resolves or downloads. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-hub</artifactId>
    </dependency>
    <!-- every architecture provider, as ServiceLoader cargo: ONE list to maintain, in
         jinfer-models-all. Runtime scope lands it on the test classpath too, so the ITs
         double as the smoke test that the aggregation carries every family. A shaded consumer
         needs the ServicesResourceTransformer. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-models-all</artifactId>
      <type>pom</type>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- E2E proof that the type-seam framing makes a single-bean VectorStore retrieval-correct -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-vector-store</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- observation assertions; matches spring-ai-model's micrometer-observation -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-observation-test</artifactId>
      <version>${micrometer.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- ChatClient for the structured-output entity() dogfood -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
