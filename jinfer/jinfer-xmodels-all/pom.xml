<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-xmodels-all</artifactId>
  <packaging>pom</packaging>

  <name>jinfer-x (all model ports)</name>
  <description>Convenience aggregator: depend on this one artifact to get every x model port on the
    classpath. Users who care about footprint depend on individual ports instead (jinfer-xllama,
    jinfer-xgemma4, ...) - Models.load dispatches by GGUF architecture over whatever ports are
    present, and a missing port fails with an error naming the artifact to add.</description>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xllama</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xgemma4</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xlfm2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xqwen3</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xqwen35</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xnemotronh</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xgptoss</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xinflect2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xmaple</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
