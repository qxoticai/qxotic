<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-models-all</artifactId>
  <packaging>pom</packaging>

  <name>jinfer (all models)</name>
  <description>Convenience aggregator: depend on this one artifact to get every model provider on the
    classpath. Users who care about footprint depend on individual ports instead (jinfer-llama,
    jinfer-gemma4, ...) - Models.load dispatches by GGUF architecture over whatever ports are
    present, and a missing port fails with an error naming the artifact to add.</description>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-llama</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-gemma4</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-lfm2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-qwen3</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-qwen35</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-nemotronh</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-gptoss</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-inflect2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-maple</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
