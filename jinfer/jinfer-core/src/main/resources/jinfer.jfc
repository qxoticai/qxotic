<?xml version="1.0" encoding="UTF-8"?>
<!--
  jinfer's JFR settings.

  Combine with a JDK profile - the point of putting inference on the JFR timeline is seeing it
  NEXT TO GC, JIT and thread state, so a recording with only these events defeats itself:

      java -XX:StartFlightRecording=settings=profile,settings=jinfer,filename=run.jfr ...

  Then read it with "jfr summary run.jfr", or filter to the jinfer category with the jfr tool's
  categories option. Note XML comments cannot contain a double hyphen, so the flags are described
  rather than spelled here.

  jinfer.Decode is one event per generated token. It is off here; enable it to correlate token
  latency with GC pauses, and leave it off otherwise.
-->
<configuration version="2.0" label="jinfer"
               description="Model loads, inference calls and the runtime actually in use."
               provider="qxotic">

  <event name="jinfer.Inference">
    <setting name="enabled">true</setting>
    <setting name="threshold">0 ms</setting>
  </event>

  <event name="jinfer.ModelLoad">
    <setting name="enabled">true</setting>
  </event>

  <event name="jinfer.Runtime">
    <setting name="enabled">true</setting>
    <setting name="period">everyChunk</setting>
  </event>

  <event name="jinfer.PromptCache">
    <setting name="enabled">true</setting>
    <setting name="period">1 s</setting>
  </event>

  <event name="jinfer.Speculation">
    <setting name="enabled">true</setting>
  </event>

  <event name="jinfer.Decode">
    <setting name="enabled">false</setting>
  </event>

</configuration>
