<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>jinfer-kernels</artifactId>
  <packaging>jar</packaging>

  <name>Jinfer Kernels</name>
  <description>Compute kernels and GGUF tensor loading for Jinfer model providers.</description>
  <properties>
    <maven.deploy.skip>false</maven.deploy.skip>
    <!-- One selection shared by the scalar and both vector-width runs. -->
    <kernel.numeric.tests>**/*ContractTest.java,**/*AccuracyTest.java,**/*MatMul*Test.java,
      **/KQuantFloorDotTest.java,**/TernaryQuantTest.java,**/MoeTest.java,
      **/ConvolutionsTest.java,**/GatedDeltaNetTest.java,**/Mamba2Test.java,
      **/*OpsTest.java,**/KimiDeltaAttentionTest.java,**/KernelSelectionTest.java</kernel.numeric.tests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-core</artifactId>
      <!-- API + ServiceLoader discovery only; the backends (jam-native/jam-vector) arrive from
           the CONSUMER's classpath. Absent -> MatMul runs the Java floor, bit-identical. -->
    </dependency>
    <!-- the pure-java jam rungs, for MatMulJamParityTest's dedicated surefire execution -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-scalar</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-vector</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- Kernel selection matrix. Every kernel picks its implementation from a static constant
             read once at class initialization (register tile, Vector API width, the vector
             recurrences, the JAM rungs on the classpath), so a JVM tests exactly one selection.
             The default runs the whole suite; variants run the affected numerical contracts.
             KernelSelectionTest pins the constants to the requested properties, so a selection
             that silently fell back to the default fails instead of re-testing it. Ordinary
             executions keep every jam-* jar off the classpath: they test the Java kernels.
             default-test is whatever this machine's compiler selects (jinfer.vectorJit=auto); the
             executions that want the vector kernels to run say vectorJit=fast explicitly, since
             on stock C2 the detection turns them off. -->
        <configuration>
          <reportsDirectory>${project.build.directory}/surefire-reports/default</reportsDirectory>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>com.qxotic:jam-native</classpathDependencyExclude>
            <classpathDependencyExclude>com.qxotic:jam-vector</classpathDependencyExclude>
            <classpathDependencyExclude>com.qxotic:jam-scalar</classpathDependencyExclude>
          </classpathDependencyExcludes>
          <excludes>
            <exclude>**/MatMulJamParityTest.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <!-- The JIT defaults: architecture-tuned conv tile, preferred vector width, vector recurrences. -->
            <id>default-test</id>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
          <execution>
            <!-- Convolutions 4x2 register tile. -->
            <id>conv-tile-4x2</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.convTile=4x2</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/conv-4x2</reportsDirectory>
              <includes>
                <include>**/ConvolutionsTest.java</include>
                <include>**/KernelSelectionTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- Convolutions 4x4 register tile: what every native image is built with (jinfer.convTile in the parent pom). -->
            <id>conv-tile-4x4</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.convTile=4x4</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/conv-4x4</reportsDirectory>
              <includes>
                <include>**/ConvolutionsTest.java</include>
                <include>**/KernelSelectionTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- FAST_VECTOR_JIT forced on: the vector recurrences and the Java k-quant decode dots run whatever compiler this is. -->
            <id>vector-jit-fast</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.vectorJit=fast</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/vector-fast</reportsDirectory>
              <includes>
                <include>**/*MatMul*Test.java</include>
                <include>**/KQuantFloorDotTest.java</include>
                <include>**/GatedDeltaNetTest.java</include>
                <include>**/Mamba2Test.java</include>
                <include>**/KernelSelectionTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- FAST_VECTOR_JIT forced off: the routing's other side. -->
            <id>vector-jit-slow</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.vectorJit=slow</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/vector-slow</reportsDirectory>
              <includes>
                <include>**/*MatMul*Test.java</include>
                <include>**/KQuantFloorDotTest.java</include>
                <include>**/GatedDeltaNetTest.java</include>
                <include>**/Mamba2Test.java</include>
                <include>**/KernelSelectionTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- Scalar Gated Delta Net and Mamba2 through their own switches, isolated from the JIT policy. -->
            <id>java-recurrences</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.vectorJit=fast -Djinfer.gdn.vector=false -Djinfer.mamba2.vector=false -Djinfer.mamba2.vectorNorm=false</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/java-recurrences</reportsDirectory>
              <includes>
                <include>**/GatedDeltaNetTest.java</include>
                <include>**/Mamba2Test.java</include>
                <include>**/KernelSelectionTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- Narrowest Vector API species (NEON width): lane-count assumptions and tails, recurrences included. -->
            <id>vector-128</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.vectorJit=fast -Djinfer.vectorBitSize=128</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/vector-128</reportsDirectory>
              <includes>
                <include>${kernel.numeric.tests}</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- AVX2 width: the two-slices-per-32-bytes mapping of the k-quant dots. -->
            <id>vector-256</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.vectorJit=fast -Djinfer.vectorBitSize=256</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/vector-256</reportsDirectory>
              <includes>
                <include>${kernel.numeric.tests}</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- No Vector API at all: the scalar fallbacks of every dot, norm, activation and conversion. -->
            <id>scalar</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.vectorBitSize=0</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/scalar</reportsDirectory>
              <includes>
                <include>${kernel.numeric.tests}</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- jam-rung parity: MatMul.mm (jam-routed) vs MatMul.mmFloor (no jam) needs the
                 pure-java backends on the classpath; jam-native stays excluded (flaky in the
                 forked JVM). -->
            <id>jam-parity</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{argLine} ${jinfer.jvm.flags} -Djinfer.kernels.expectJam=vector,scalar</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports/jam</reportsDirectory>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>com.qxotic:jam-native</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <excludes>
                <exclude>none</exclude>
              </excludes>
              <includes>
                <include>**/MatMulJamParityTest.java</include>
                <include>**/KernelSelectionTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Build-time only: the GraalVM inlining annotations compile against name-matching stubs that
         are never published. Declared in a build profile (always on in this reactor) because the
         flatten plugin drops such dependencies from the released POM, so no consumer ever sees the
         com.qxotic:graalvm-annotations coordinate. -->
    <profile>
      <id>graalvm-annotations</id>
      <activation>
        <property>
          <name>!qxotic.noGraalvmAnnotations</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.qxotic</groupId>
          <artifactId>graalvm-annotations</artifactId>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
