<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>jinfer-kernels</artifactId>
  <packaging>jar</packaging>

  <name>jinfer-kernels</name>
  <description>Internal to jinfer (no API promise). Compute kernels over com.qxotic.jota.memory.MemoryView&lt;MemorySegment&gt; (matmul, norms, rope,
    convolutions, flash attention, activations, MoE) plus GGUF loading and FP16 KvTransfer. Model
    implementation modules (jinfer-lfm2, ...) depend on this module for the kernels.</description>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-core</artifactId>
      <!-- API + ServiceLoader discovery only; the backends (jam-native/jam-vector) arrive from
           the CONSUMER's classpath. Absent -> MatMul runs the Java floor, bit-identical. -->
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>graalvm-annotations</artifactId>
      <!-- @AlwaysInline: compile-only, not bundled; GraalVM supplies it at native-image build -->
      <scope>provided</scope>
    </dependency>
    <!-- the pure-java jam rungs, for MatMulJamParityTest's dedicated surefire execution -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-scalar</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-vector</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- Kernel selection matrix. Every kernel picks its implementation from a static constant
             read once at class initialization (register tile, Vector API width, the vector
             recurrences, the JAM rungs on the classpath), so a JVM tests exactly one selection.
             Each execution below re-runs the whole suite (~2 s) under one selection and
             KernelSelectionTest pins the constants to the requested properties, so a selection
             that silently fell back to the default fails instead of re-testing it. Ordinary
             executions keep every jam-* jar off the classpath: they test the Java kernels.
             default-test is whatever this machine's compiler selects (jinfer.vectorJit=auto); the
             executions that want the vector kernels to run say vectorJit=fast explicitly, since
             on stock C2 the detection turns them off. -->
        <configuration>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>com.qxotic:jam-native</classpathDependencyExclude>
            <classpathDependencyExclude>com.qxotic:jam-vector</classpathDependencyExclude>
            <classpathDependencyExclude>com.qxotic:jam-scalar</classpathDependencyExclude>
          </classpathDependencyExcludes>
          <excludes>
            <exclude>**/MatMulJamParityTest.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <!-- The JIT defaults: 4x1 conv tile, preferred vector width, vector recurrences. -->
            <id>default-test</id>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
          <execution>
            <!-- Convolutions 4x2 register tile. -->
            <id>conv-tile-4x2</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.convTile=4x2</argLine>
            </configuration>
          </execution>
          <execution>
            <!-- Convolutions 4x4 register tile: what every native image is built with (jinfer.convTile in the parent pom). -->
            <id>conv-tile-4x4</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.convTile=4x4</argLine>
            </configuration>
          </execution>
          <execution>
            <!-- FAST_VECTOR_JIT forced on: the vector recurrences and the Java k-quant decode dots run whatever compiler this is. -->
            <id>vector-jit-fast</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.vectorJit=fast</argLine>
            </configuration>
          </execution>
          <execution>
            <!-- FAST_VECTOR_JIT forced off: the routing's other side. -->
            <id>vector-jit-slow</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.vectorJit=slow</argLine>
            </configuration>
          </execution>
          <execution>
            <!-- Scalar Gated Delta Net and Mamba2 through their own switches, isolated from the JIT policy. -->
            <id>java-recurrences</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.vectorJit=fast -Djinfer.gdn.vector=false -Djinfer.mamba2.vector=false -Djinfer.mamba2.vectorNorm=false</argLine>
            </configuration>
          </execution>
          <execution>
            <!-- Narrowest Vector API species (NEON width): lane-count assumptions and tails, recurrences included. -->
            <id>vector-128</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.vectorJit=fast -Djinfer.vectorBitSize=128</argLine>
            </configuration>
          </execution>
          <execution>
            <!-- No Vector API at all: the scalar fallbacks of every dot, norm, activation and conversion. -->
            <id>scalar</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.vectorBitSize=0</argLine>
            </configuration>
          </execution>
          <execution>
            <!-- jam-rung parity: MatMul.mm (jam-routed) vs MatMul.mmFloor (no jam) needs the
                 pure-java backends on the classpath; jam-native stays excluded (flaky in the
                 forked JVM). -->
            <id>jam-parity</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djinfer.kernels.expectJam=vector,scalar</argLine>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>com.qxotic:jam-native</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <excludes>
                <exclude>none</exclude>
              </excludes>
              <includes>
                <include>**/MatMulJamParityTest.java</include>
                <include>**/KernelSelectionTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
