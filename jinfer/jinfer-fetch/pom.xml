<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.4.0</version>
  </parent>

  <artifactId>jinfer-fetch</artifactId>

  <name>Jinfer Fetch</name>
  <description>One HTTP GET, two ways to make it: the JDK client, or curl as a process. The hub
    downloaders run on it, and a native image that leaves the JDK client out carries no TLS stack.</description>

  <properties>
    <maven.deploy.skip>false</maven.deploy.skip>
    <!-- Java 11, below jinfer's 25: toknroll-hf and toknroll-gguf download through it -->
    <maven.compiler.release>11</maven.compiler.release>
    <maven.compiler.testRelease>11</maven.compiler.testRelease>
  </properties>

  <build>
    <plugins>
      <plugin>
        <!-- none of jinfer's incubator flags: the test's local server lives in jdk.httpserver,
             which the module does not read -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs combine.self="override" />
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.self="override">
                <arg>--add-modules</arg>
                <arg>jdk.httpserver</arg>
                <arg>--add-reads</arg>
                <arg>com.qxotic.jinfer.fetch=jdk.httpserver</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- jinfer's vector modules dropped, the root's no-fonts kept -->
          <additionalOptions combine.self="override">
            <additionalOption>--no-fonts</additionalOption>
          </additionalOptions>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} --add-modules jdk.httpserver --add-reads com.qxotic.jinfer.fetch=jdk.httpserver</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
