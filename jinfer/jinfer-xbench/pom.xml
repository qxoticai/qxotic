<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-xbench</artifactId>
  <packaging>jar</packaging>

  <name>jinfer-xbench</name>
  <description>A/B bench for the MemoryView ports: JinferBench's harness verbatim, driving both old
    and x LFM2/Gemma 4 implementations behind one --impl flag, so old vs x pp/tg is measured by one
    timing loop in one JVM. A consumer of both trees, not an x-module: the "x never deps on old"
    rule does not apply here - comparing them is the whole point.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xcore</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xkernels</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xlfm2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xqwen3</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xgemma4</artifactId>
    </dependency>
    <!-- the old tree, benchmarked against the x port -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-lfm2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-qwen3</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-gemma4</artifactId>
    </dependency>
    <!-- the native JAM backend BOTH trees route prefill gemm to (ServiceLoader-discovered);
         the whole point of the A/B -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-native</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
