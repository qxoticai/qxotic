  </parent>

  <artifactId>jinfer-qwen3</artifactId>
  <packaging>jar</packaging>

  <name>jinfer-qwen3</name>
  <!-- Architecture "qwen3" is the RETRIEVAL family - Qwen3-Embedding and Qwen3-Reranker share one
       backbone. The generative Qwen 3.5 models are architecture "qwen35"/"qwen35moe", in
       jinfer-qwen35: one character apart in the name, a different family in the GGUF. -->
  <description>Qwen3 retrieval port: Qwen3-Embedding (pooled) and Qwen3-Reranker (judge)</description>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-kernels</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-kernels</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
