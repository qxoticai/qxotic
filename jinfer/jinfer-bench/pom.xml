<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>jinfer-bench</artifactId>
  <packaging>jar</packaging>

  <name>jinfer-bench</name>
  <description>Benchmark harness: llama-bench-parity pp/tg through the generic model
    loader (any architecture on the classpath), plus engine-level capability metrics - TTFT,
    prompt-cache hit latency, MTP acceptance, projected-media cold/warm, state allocation, peak
    RSS, convolution tuning and decode-pool dispatch cost.</description>

  <properties>
    <jinfer.image.name>jinfer-bench</jinfer.image.name>
    <jinfer.image.mainClass>com.qxotic.jinfer.bench.JinferBench</jinfer.image.mainClass>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-codecs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-kernels</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-core</artifactId>
    </dependency>
    <!-- Model ports and JAM backends are selected through ServiceLoader. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-models-all</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-native</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-vector</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-scalar</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <!-- The shade + native-image configuration lives in jinfer-parent's pluginManagement; this
       module only names the executable it produces (the jinfer.image.* properties above). -->
  <build>
    <finalName>${jinfer.image.name}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
