  <properties>
    <maven.compiler.release>25</maven.compiler.release>

    <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    <native-maven-plugin.version>0.10.6</native-maven-plugin.version>

    <!-- Per-executable knobs for the shared shade + native-image config below. A module that ships a
         binary overrides jinfer.image.name/mainClass (and addModules, when it needs more than the
         Vector API); everything else inherits the defaults. -->
    <jinfer.image.name>jinfer</jinfer.image.name>
    <jinfer.image.mainClass>com.qxotic.jinfer.Main</jinfer.image.mainClass>
    <jinfer.image.addModules>jdk.incubator.vector</jinfer.image.addModules>

    <!-- native builder opt-in: wide 512-bit register tiles (needs a 32-ZMM Graal, GR-13757) -->
    <jam.wideTiles>false</jam.wideTiles>

    <!-- Convolutions' register tile. A BUILD-time knob for the image, not a run-time one: the
         image initializes com.qxotic.* at build time, so Convolutions.TILE_CODE is frozen here
         and -Djinfer.convTile on the binary is silently ignored (measured: identical throughput
         for every value). Passing it here is also what keeps TILE_CODE a true constant, so the
         tile branch folds away entirely in the image.

         4x4 rather than the JIT's 4x1: native-image allocates from all 32 zmm, so the 21 live
         vectors of a 4x4 tile stay in registers where a JIT limited to zmm0-15 spills them.
         Measured on Oracle GraalVM 25.2.4+7.1 / Zen 5, Inflect2 end to end: +14% (nano) and +29%
         (micro), output bit-identical. VALIDATED ON THAT BUILDER — an older native-image whose
         allocator only uses 16 vector registers would spill exactly as the JIT does, so build with
         -Djinfer.convTile=auto there. Deeper does not pay: 4x6 and 6x4 were measured and are
         slower than 4x4 everywhere (see Convolutions.TILE_CODE). -->
    <jinfer.convTile>4x4</jinfer.convTile>

    <!-- Per-layer tensor tracing, build-time for the same reason as the tile: Trace.ENABLED guards
         hot loops, so it must fold to a constant. Empty would read as ON (the flag tests for
         presence), hence "false" rather than a blank default. -->
    <jinfer.trace>false</jinfer.trace>

    <!-- Tagged suites excluded from the default build:
         integration = model-loading gates (run: mvn test -Dsurefire.excludedGroups= -Dgroups=integration)
         bench       = measurement harnesses (run by name: mvn test -Dtest=GemvBench -Dsurefire.excludedGroups=)
         driver      = hand tools (run by name, args via -Djinfer.args="...") -->
    <surefire.excludedGroups>integration,bench,driver</surefire.excludedGroups>
    <jinfer.preload />

    <!-- the Spring AI backend modules (jinfer-spring-ai*) -->
    <spring-ai.version>2.0.0</spring-ai.version>
    <spring-boot.version>4.1.0</spring-boot.version>
    <!-- observation test assertions; matches spring-ai-model's micrometer-observation -->
    <micrometer.version>1.17.0</micrometer.version>

    <!-- test libraries shared by the backend modules -->
    <assertj.version>3.27.6</assertj.version>
    <mockito.version>5.21.0</mockito.version>
  </properties>

