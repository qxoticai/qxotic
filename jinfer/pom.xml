  <!-- The one test framework, inherited by every module (version managed by the qxotic parent). -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Legal pair (LICENSE + NOTICE) is inherited from the qxotic parent's resources. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <compilerArgs>
              <arg>--add-modules</arg>
              <arg>jdk.incubator.vector,jdk.httpserver</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <configuration>
            <!-- doclint checks CORRECTNESS, not presence: broken @link, bad references and
                 malformed HTML fail the build; a missing @param on a self-evident argument does
                 not. A doc that says "@param n the n" is noise, and a policy that demands one
                 produces a hundred of them. Incubator module flags mirror the compiler's, or
                 javadoc cannot resolve the types it is documenting. -->
            <doclint>all,-missing</doclint>
            <additionalOptions>
              <additionalOption>--add-modules</additionalOption>
              <additionalOption>jdk.incubator.vector,jdk.httpserver</additionalOption>
            </additionalOptions>
            <source>${maven.compiler.release}</source>
            <quiet>true</quiet>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Every src/test class is JUnit; discovery scans all classes (non-@Test helpers are
                 ignored). Integration/bench/driver tags are opt-in; see surefire.excludedGroups
                 above. -->
            <argLine>--add-modules jdk.incubator.vector,jdk.httpserver --enable-native-access=ALL-UNNAMED</argLine>
            <excludedGroups>${surefire.excludedGroups}</excludedGroups>
            <includes>
              <include>**/*.java</include>
            </includes>
          </configuration>
        </plugin>

        <!-- Shared executable fat-jar and native-image configuration. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <executions>
            <execution>
              <goals>
                <goal>shade</goal>
              </goals>
              <phase>package</phase>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>${jinfer.image.mainClass}</mainClass>
                    <manifestEntries>
                      <!-- jinfer maps weights with MemorySegment::reinterpret. Declaring it here
                           means `java -jar jinfer.jar` is quiet: without it the JVM prints four
                           restricted-method warnings that only the native-access flag silences,
                           and a user reading them cannot tell them from a real problem. -->
                      <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    </manifestEntries>
                  </transformer>
                  <!-- merge META-INF/services across modules (ModelProvider arch dispatch) -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                  <!-- All in-house jars carry the same canonical META-INF/LICENSE and NOTICE from
                       the qxotic parent; first-wins keeps one copy (appending would duplicate the
                       identical text once per shaded jar). The .txt/.md variants stay appending
                       for future third-party cargo. -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/LICENSE.txt</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/LICENSE.md</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/NOTICE.txt</resource>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                    <resource>META-INF/NOTICE.md</resource>
                  </transformer>
                </transformers>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                    </excludes>
                  </filter>
                </filters>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <!-- Shared by the Spring example apps: spring-boot:run with jinfer's JVM flags. -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <configuration>
            <jvmArguments>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED</jvmArguments>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>${native-maven-plugin.version}</version>
          <extensions>true</extensions>
          <configuration>
            <imageName>${jinfer.image.name}</imageName>
            <mainClass>${jinfer.image.mainClass}</mainClass>
            <buildArgs>
              <buildArg>-O3</buildArg>
              <buildArg>-Djam.vector.wideTiles=${jam.wideTiles}</buildArg>
              <buildArg>-march=native</buildArg>
              <!-- Correctness flags (Vector/FFM support, add-modules, native-access,
                   build-time init policy and per-class run-time exemptions) come from each module's
                   jar-resident native-image.properties; this recipe only adds the optimization and
                   resource knobs that are specific to the shipped CLI binary.

                   SharedArenaSupport stays OFF: it is mutually exclusive with VectorAPISupport on
                   every current builder, so the image
                   runs with Arenas' ofAuto degrade (GC-eventual frees). When GraalVM lifts the
                   restriction, re-enable real shared arenas with -H:+SharedArenaSupport and
                   -Djinfer.sharedArenas=true (the Arenas hook already honors it). -->
              <buildArg>-H:IncludeResources=com/qxotic/jam/native/.*</buildArg>
              <buildArg>-Djdk.incubator.vector.VECTOR_ACCESS_OOB_CHECK=0</buildArg>
              <buildArg>-Djinfer.preload=${jinfer.preload}</buildArg>
              <buildArg>-Djinfer.convTile=${jinfer.convTile}</buildArg>
              <buildArg>-Djinfer.trace=${jinfer.trace}</buildArg>
            </buildArgs>
          </configuration>
          <executions>
            <execution>
              <id>build-native</id>
              <goals>
                <goal>compile-no-fork</goal>
              </goals>
              <phase>package</phase>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-jinfer-java</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>jinfer requires JDK 25 (the current LTS)</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

