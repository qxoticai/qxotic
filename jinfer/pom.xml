  <!-- The one test framework, inherited by every module (version managed by the qxotic parent). -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <enablePreview>true</enablePreview>
            <compilerArgs>
              <arg>--add-modules</arg>
              <arg>jdk.incubator.vector,jdk.httpserver</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <configuration>
            <!-- doclint checks CORRECTNESS, not presence: broken @link, bad references and
                 malformed HTML fail the build; a missing @param on a self-evident argument does
                 not. A doc that says "@param n the n" is noise, and a policy that demands one
                 produces a hundred of them. Preview + incubator flags mirror the compiler's, or
                 javadoc cannot parse the sources it is documenting. -->
            <doclint>all,-missing</doclint>
            <additionalOptions>
              <additionalOption>--enable-preview</additionalOption>
              <additionalOption>--add-modules</additionalOption>
              <additionalOption>jdk.incubator.vector,jdk.httpserver</additionalOption>
            </additionalOptions>
            <source>${maven.compiler.release}</source>
            <quiet>true</quiet>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Every src/test class is JUnit; discovery scans all classes (non-@Test helpers are
                 ignored). Unit tests + weights-free oracles run in every build (oracles skip via
                 assumptions when their GGUF is absent); integration/bench/driver tags are opt-in -
                 see surefire.excludedGroups above. -->
            <argLine>--add-modules jdk.incubator.vector,jdk.httpserver --enable-preview --enable-native-access=ALL-UNNAMED</argLine>
            <excludedGroups>${surefire.excludedGroups}</excludedGroups>
            <includes>
              <include>**/*.java</include>
            </includes>
          </configuration>
        </plugin>

        <!-- Shared by jinfer-cli and jinfer-bench: an executable fat jar, and (under -Pnative) the
             native image built from it. Both differ only in the jinfer.image.* properties. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>shade</goal>
              </goals>
              <phase>package</phase>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>${jinfer.image.mainClass}</mainClass>
                    <manifestEntries>
                      <!-- jinfer maps weights with MemorySegment::reinterpret. Declaring it here
                           means `java -jar jinfer.jar` is quiet: without it the JVM prints four
                           restricted-method warnings that only the native-access flag silences,
                           and a user reading them cannot tell them from a real problem. -->
                      <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    </manifestEntries>
                  </transformer>
                  <!-- merge META-INF/services across modules (ModelProvider arch dispatch) -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                </transformers>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                    </excludes>
                  </filter>
                </filters>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <!-- Shared by the Spring example apps: spring-boot:run with jinfer's JVM flags. -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <configuration>
            <jvmArguments>--enable-preview --add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED</jvmArguments>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>${native-maven-plugin.version}</version>
          <extensions>true</extensions>
          <configuration>
            <imageName>${jinfer.image.name}</imageName>
            <mainClass>${jinfer.image.mainClass}</mainClass>
            <buildArgs>
              <buildArg>-O3</buildArg>
              <buildArg>-Djam.vector.wideTiles=${jam.wideTiles}</buildArg>
              <buildArg>-march=native</buildArg>
              <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
              <buildArg>-H:+VectorAPISupport</buildArg>
              <buildArg>-H:+ForeignAPISupport</buildArg>
              <!-- SharedArenaSupport is mutually exclusive with VectorAPISupport on every current
                   builder (verified through Oracle GraalVM 25.2.4+7.1: the check fires once the
                   vector module is actually in the image), so the image runs with Arenas' ofAuto
                   degrade (GC-eventual frees). When GraalVM lifts the restriction, re-enable real
                   shared arenas with two args here: -H:+SharedArenaSupport and
                   -Djinfer.sharedArenas=true (the Arenas hook already honors it). -->
              <buildArg>--enable-preview</buildArg>
              <buildArg>--add-modules</buildArg>
              <buildArg>${jinfer.image.addModules}</buildArg>
              <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
              <buildArg>-J--enable-native-access=ALL-UNNAMED</buildArg>
              <buildArg>--initialize-at-build-time=com.qxotic.</buildArg>
              <!-- LeakWatch, BaseState and CacheStore for the same reason: their Cleaners cannot
                   live in the image heap (the daemon thread does not survive the build); LeakWatch
                   additionally because -Djinfer.leakDetection is a RUN-time flag that build-time
                   initialization would freeze to the builder's value. -->
              <buildArg>--initialize-at-run-time=com.qxotic.jinfer.RuntimeFlags,com.qxotic.jinfer.Parallel,com.qxotic.jinfer.MatMul,com.qxotic.jinfer.Dispatch,com.qxotic.jinfer.JamMatMul,com.qxotic.jinfer.LeakWatch,com.qxotic.jinfer.LeakWatch$Holder,com.qxotic.jinfer.BaseState,com.qxotic.jinfer.cache.CacheStore,com.qxotic.jinfer.x.boundary.RuntimeFlags,com.qxotic.jinfer.x.boundary.LeakWatch,com.qxotic.jinfer.x.boundary.LeakWatch$Holder,com.qxotic.jinfer.x.boundary.BaseState,com.qxotic.jinfer.x.cache.CacheStore,com.qxotic.jinfer.x.kernels.MatMul,com.qxotic.jinfer.x.RuntimeFlags,com.qxotic.jinfer.x.Parallel,com.qxotic.jinfer.models.gemma4.VisionPreprocess,com.qxotic.jinfer.hub.Fetch,com.qxotic.jinfer.hub.Proxies,com.qxotic.jam.NativeJAM,com.qxotic.jam.NativeLoader</buildArg>
              <!-- hub.Fetch/Proxies: an HttpClient cannot live in the image heap, and both read
                   JINFER_DOWNLOAD_THREADS and the proxy variables into statics - build-time init
                   would freeze the BUILD machine's environment into the binary. -->
              <buildArg>-H:IncludeResources=com/qxotic/jam/native/.*</buildArg>
              <buildArg>-Djdk.incubator.vector.VECTOR_ACCESS_OOB_CHECK=0</buildArg>
              <buildArg>-Djinfer.preload=${jinfer.preload}</buildArg>
              <buildArg>-Djinfer.convTile=${jinfer.convTile}</buildArg>
              <buildArg>-Djinfer.trace=${jinfer.trace}</buildArg>
            </buildArgs>
          </configuration>
          <executions>
            <execution>
              <id>build-native</id>
              <goals>
                <goal>compile-no-fork</goal>
              </goals>
              <phase>package</phase>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
