<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-inflect2</artifactId>
  <packaging>jar</packaging>

  <name>jinfer-inflect2</name>
  <description>Inflect-Nano-v2 TTS engine port (VITS-family text-to-waveform)</description>

  <properties>
    <jinfer.image.name>inflect</jinfer.image.name>
    <jinfer.image.mainClass>com.qxotic.jinfer.models.inflect2.InflectCli</jinfer.image.mainClass>
    <!-- Directory of .gguf files to ZIP-embed into the native binary (no compression) -->
    <inflect.embed.models />
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-core</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.qxotic</groupId>
          <artifactId>jam-native</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-kernels</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.28.0</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-kernels</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>native</id>
      <properties>
        <!-- Where the model fixtures live, same resolution as the testkit's ModelFixture:
             -Djinfer.models, else the models directory beside the checkout. -->
        <jinfer.models>${maven.multiModuleProjectDirectory}/../../models</jinfer.models>
        <jinfer.lexicon.dir>${jinfer.models}/hf.co/remixerdec/Inflect-Nano-v2-GGUF</jinfer.lexicon.dir>
      </properties>
      <build>
        <plugins>
          <!-- The lexicon is 1.5 MB of downloaded fixture and MUST NOT enter the repository. A
               single-file binary has no directory to sit beside, so it is copied into the image's
               classpath here, at build time, from wherever the fixtures were downloaded. Absent =
               the image falls back to espeak-ng at run time, which is a working image, not a
               broken one. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>embed-lexicon</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${jinfer.lexicon.dir}</directory>
                      <includes>
                        <include>lexicon.bin</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
