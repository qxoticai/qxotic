<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.3.1</version>
  </parent>

  <artifactId>jinfer-native</artifactId>
  <packaging>jar</packaging>

  <name>Jinfer Native Library</name>
  <description>libjinfer: jinfer as a shared library with a C API (include/jinfer.h), built with
    GraalVM Native Image. Consumed from Python, C and any language with a foreign function
    interface. Not a Maven dependency; the shared library is the artifact.</description>

  <properties>
    <jinfer.image.name>libjinfer</jinfer.image.name>
    <!-- -O3 for a shipped library; the Makefile passes -Ob for the dev loop. -->
    <jinfer.image.opt>-O3</jinfer.image.opt>
    <!-- The ISA level, x86-64-v3 (AVX2) being the kernels' floor; the Makefile passes compatibility on other
         architectures and native for the dev loop. -->
    <!-- GraalVM's own default target on x86-64, spelled out: the plugin cannot leave the flag out -->
    <jinfer.image.march>x86-64-v3</jinfer.image.march>
    <!-- The Vector API width in bits, empty = what the target ISA (-march) can execute, which the
         VectorWidth feature pins at build time. Set it only to build narrower than the target. -->
    <jinfer.image.vectorBits />
    <!-- the shims' C compiler, cc with GCC spellings; the windows profile swaps in cl, whose -D -I -c read the same -->
    <shim.cc>cc</shim.cc>
    <shim.cflags>-std=c11 -O2 -fPIC -Wall -Wextra -Wpedantic</shim.cflags>
    <shim.out>-o</shim.out>
    <shim.obj>.o</shim.obj>
    <shim.wrapper>--native-compiler-path=${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/src/main/c/native-cc.sh</shim.wrapper>
    <!-- the linker line that pulls libjam's archive into the image whole (the windows profile spells it for link.exe) -->
    <jam.link>-H:NativeLinkerOption=-Wl,--whole-archive,${maven.multiModuleProjectDirectory}/jam/jam-native/build/libjam.a,--no-whole-archive</jam.link>
    <graalvm.sdk.version>25.0.1</graalvm.sdk.version>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-hub</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-codecs</artifactId>
    </dependency>
    <dependency>
      <!-- the OpenAI chat.completions dialect: OpenAiChat is the seam the server exposes for in-process hosts -->
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-server</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-core</artifactId>
    </dependency>
    <dependency>
      <!-- the toknroll_* entry points: libjinfer carries the tokenizer API under toknroll.h -->
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-native</artifactId>
      <version>${toknroll.version}</version>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <!-- the @CEntryPoint annotations and C type views; the image builder supplies them at run time -->
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>nativeimage</artifactId>
      <version>${graalvm.sdk.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- VectorWidth: the builder's own hosted API (CPUFeatureAccess) -->
      <groupId>org.graalvm.nativeimage</groupId>
      <artifactId>svm</artifactId>
      <version>${graalvm.sdk.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-models-all</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-native</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-vector</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-scalar</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- see jinfer-cli: jinfer-kernels' ModelLoader needs both at run time; compile scope keeps
         them from being shadowed -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <!-- The C face of the library is one translation unit, compiled with the platform C
                 compiler and linked into the image below. -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-shim</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <executable>${shim.cc}</executable>
                  <commandlineArgs>${shim.cflags} -DJINFER_BUILD -I${project.basedir}/include -I${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/include -I${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/src/main/c -c ${project.basedir}/src/main/c/jinfer_shim.c ${shim.out}${project.build.directory}/jinfer_shim${shim.obj}</commandlineArgs>
                </configuration>
              </execution>
              <!-- toknroll's C face too: the shim forwarding to the toknroll__* entry points, and the
                   isolate they run in, which jinfer_* shares (jinfer_shim.c has none of its own); the isolate
                   is told the image's own file as jam.native.library.path, where libjam, linked in below, is -->
              <execution>
                <id>compile-toknroll-shim</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <executable>${shim.cc}</executable>
                  <commandlineArgs>${shim.cflags} -DTOKNROLL_BUILD -I${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/include -c ${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/src/main/c/toknroll_shim.c ${shim.out}${project.build.directory}/toknroll_shim${shim.obj}</commandlineArgs>
                </configuration>
              </execution>
              <execution>
                <id>compile-toknroll-isolate</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <executable>${shim.cc}</executable>
                  <commandlineArgs>${shim.cflags} -DTOKNROLL_PROGRAM=jinfer -DTOKNROLL_OPTIONS_ENV=JINFER_OPTIONS -DTOKNROLL_SELF_PROPERTY=jam.native.library.path -DTOKNROLL_FORK_REFUSED -I${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/include -c ${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/src/main/c/toknroll_isolate.c ${shim.out}${project.build.directory}/toknroll_isolate${shim.obj}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <!-- A shared library, not the parent's executable recipe: restated whole. The
                 correctness flags still come from each jar's native-image.properties. -->
            <configuration combine.self="override">
              <imageName>${jinfer.image.name}</imageName>
              <sharedLibrary>true</sharedLibrary>
              <!-- a fallback image would need a JDK at run time: a library that is not standalone is a failure -->
              <fallback>false</fallback>
              <buildArgs>
                <buildArg>${jinfer.image.opt}</buildArg>
                <buildArg>-march=${jinfer.image.march}</buildArg>
                <buildArg>-H:NativeLinkerOption=${project.build.directory}/jinfer_shim${shim.obj}</buildArg>
                <buildArg>-H:NativeLinkerOption=${project.build.directory}/toknroll_shim${shim.obj}</buildArg>
                <buildArg>-H:NativeLinkerOption=${project.build.directory}/toknroll_isolate${shim.obj}</buildArg>
                <!-- the shim's jinfer_* symbols are the API; the wrapper adds them to GraalVM's export
                     list, which otherwise names only the image's own entry points -->
                <buildArg>${shim.wrapper}</buildArg>
                <!-- native-image runs the compiler in an environment of its own: name the wrapper's opt-in log -->
                <buildArg>-ENATIVE_CC_LOG</buildArg>
                <!-- a C library, not a JVM: no JNI_CreateJavaVM and friends in the export table -->
                <buildArg>-H:-JNIExportSymbols</buildArg>
                <buildArg>-EMACOSX_DEPLOYMENT_TARGET</buildArg>
                <!-- jinfer_model_options is read through the header itself (Options.Directives), which includes toknroll.h -->
                <buildArg>-Djinfer.native.include=${project.basedir}/include${path.separator}${maven.multiModuleProjectDirectory}/toknroll/toknroll-native/include</buildArg>
                <buildArg>--features=com.qxotic.jinfer.libjinfer.VectorWidth</buildArg>
                <buildArg>-J--add-exports=org.graalvm.nativeimage.builder/com.oracle.svm.core=ALL-UNNAMED</buildArg>
                <!-- libjam linked into the image, whole: nothing in the image references its symbols statically
                     (jam resolves them by name at run time, from the image's own file: TOKNROLL_SELF_PROPERTY above),
                     so without whole-archive the linker would drop every member; no bundled copy is left to extract -->
                <buildArg>${jam.link}</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <!-- downloads go through curl as a process (fetch's CurlTransport): no TLS stack in the image -->
                <buildArg>-H:ServiceLoaderFeatureExcludeServiceProviders=com.qxotic.fetch.JdkTransport</buildArg>
                <buildArg>-H:ExcludeResources=com/qxotic/jam/native/.*</buildArg>
                <buildArg>-Djam.vector.wideTiles=${jam.wideTiles}</buildArg>
                <!-- the kernels' vector width: the target ISA's unless narrowed here (VectorWidth) -->
                <buildArg>-Djinfer.vectorBitSize=${jinfer.image.vectorBits}</buildArg>
                <buildArg>-Djdk.incubator.vector.VECTOR_ACCESS_OOB_CHECK=0</buildArg>
                <buildArg>-Djinfer.convTile=${jinfer.convTile}</buildArg>
                <buildArg>-Djinfer.trace=${jinfer.trace}</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Windows: the MSVC toolchain native-image requires there. No compiler wrapper: the shim's
           __declspec(dllexport) names are the export list and link.exe takes nothing else, so the
           wrapper's slot holds a flag the build has anyway. The DLL keeps Windows' name, no lib prefix. -->
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <jinfer.image.name>jinfer</jinfer.image.name>
        <shim.cc>cl</shim.cc>
        <shim.cflags>-nologo -std:c11 -O2 -W4</shim.cflags>
        <shim.out>-Fo</shim.out>
        <shim.obj>.obj</shim.obj>
        <shim.wrapper>-H:-JNIExportSymbols</shim.wrapper>
        <!-- link.exe's whole-archive: jam.lib is the clang-built static archive, jam_import.lib the DLL's -->
        <jam.link>-H:NativeLinkerOption=/WHOLEARCHIVE:${maven.multiModuleProjectDirectory}/jam/jam-native/build/jam.lib</jam.link>
      </properties>
    </profile>
  </profiles>
</project>
