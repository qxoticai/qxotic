<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.3.0</version>
  </parent>

  <artifactId>jinfer-bom</artifactId>
  <!-- Releases independently: a new catalog is how consumers receive an artifact that moved alone
       (jam-native, say) without the jinfer libraries being released again. -->
  <version>0.3.1</version>
  <packaging>pom</packaging>

  <name>Jinfer BOM</name>
  <description>Version catalog for Jinfer and its Jota, GGUF, Tok'n'Roll, and JAM dependencies.</description>
  <properties>
    <maven.deploy.skip>false</maven.deploy.skip>
  </properties>

  <!--
    Every version below is written out: the published catalog has no parent and no properties, so
    an expression in it would not resolve in a consumer's build. Each follows the version its
    artifact declares, and the release canary fails when one does not.

    a BOM is a dependencyManagement section with no jars behind it. This one manages the
    jinfer artifacts that are meant to be depended on (excluded: the shaded executables, which
    jinfer-cli ships as and nobody consumes as a library, with jinfer-bench and jinfer-tts;
    jinfer-server, which only the CLI embeds; jinfer-maple, built only with -Pmaple) plus
    the substrate versions jinfer's transitive graph resolves against. Keeping the substrate here,
    rather than letting each jinfer artifact's own POM float it, is what makes "one import, one
    coherent release" true for downstream builds that also add a jam accelerator or jota directly.
  -->
  <dependencyManagement>
    <dependencies>
      <!-- jinfer library artifacts -->
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-core</artifactId>
        <version>0.3.0</version>
      </dependency>
      <!-- internal: managed for version alignment only, not an API -->
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-codecs</artifactId>
        <version>0.3.0</version>
      </dependency>
      <!-- internal: managed for version alignment only, not an API -->
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-kernels</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-cache</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-chat</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-hub</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-jinja</artifactId>
        <version>0.3.0</version>
      </dependency>

      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-langchain4j</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-spring-ai</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-spring-ai-autoconfigure</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-spring-ai-spring-boot-starter</artifactId>
        <version>0.3.0</version>
      </dependency>

      <!-- architecture ports -->
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-lfm2</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-qwen3</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-qwen35</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-bailingmoe3</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-laguna</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-mellum</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-gemma4</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-gptoss</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-nemotronh</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-parakeet</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-llama</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-inflect2</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-kokoro</artifactId>
        <version>0.3.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-models-all</artifactId>
        <version>0.3.0</version>
      </dependency>

      <!-- Substrate this release was built against. The jinfer ports' transitive graphs resolve
           these already; pinning them here is what keeps a direct jota/jam/gguf/toknroll
           dependency aligned when a downstream build adds one. Each of those projects moves on
           its own version, written out here because a property of this build does not resolve in
           a consumer's: the root POM's gguf.version and friends are what to keep these in step
           with. -->
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jota-core</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jota-memory</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>gguf</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>json</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-core</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-gguf</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-hf</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jam-core</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jam-native</artifactId>
        <version>0.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jam-scalar</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jam-vector</artifactId>
        <version>0.2.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    the root release profile flattens every module with `oss` mode, which strips
    dependencyManagement - exactly what a BOM is. Override the same profile id here so a `mvn
    -Prelease` build publishes this catalog with the `bom` flatten mode instead of an empty POM.
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <configuration>
              <flattenMode>bom</flattenMode>
              <pomElements>
                <!-- Inherited build properties are not API. -->
                <properties>remove</properties>
              </pomElements>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
