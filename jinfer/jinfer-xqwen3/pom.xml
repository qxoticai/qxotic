<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jinfer-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>jinfer-xqwen3</artifactId>
  <packaging>jar</packaging>

  <name>jinfer-xqwen3</name>
  <description>MemoryView text, embedding, and reranking inference for Qwen3.</description>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xcore</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xkernels</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xboundary</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xchat</artifactId>
      <!-- ModelProvider + the retrieval load path (ServiceLoader cargo) -->
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-xllm</artifactId>
      <!-- SpecialTokens: the embedder's trailing-EOS lookup -->
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-gguf</artifactId>
    </dependency>
    <!-- differential gate: the old Qwen3 port (and its tree), test-scope ONLY -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-qwen3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-llm</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the shipped scorer (Models.loadReranker -> Qwen3Provider -> old Qwen3Reranker): the
           score leg's oracle, and its Models dispatch needs the ServiceLoader wiring -->
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-chat</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- test-only: checkpoint acquisition by ref (lookup only, never a download) -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Differential oracles compare against the JAVA floor: exclude the JAM backends so
               the old Dispatch routes gemm/gemv to the same dot-based code. JAM parity arrives
               with the JAM arm of x.MatMul. -->
          <classpathDependencyExcludes>
            <classpathDependencyExclude>com.qxotic:jam-native</classpathDependencyExclude>
            <classpathDependencyExclude>com.qxotic:jam-vector</classpathDependencyExclude>
            <classpathDependencyExclude>com.qxotic:jam-scalar</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
