      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-core</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-incubator</artifactId>
