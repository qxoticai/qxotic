<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.qxotic</groupId>
  <artifactId>qxotic-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>

  <name>Quixotic AI Parent</name>
  <description>Java toolkit for local LLM inference on the JVM: models, tokenizers, tensors, and
    quantized kernels. Aggregator/parent POM; depend on the individual artifacts.</description>
  <url>https://qxotic.ai</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>Quixotic AI</name>
    <url>https://qxotic.ai</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Quixotic AI Team</name>
      <organization>Quixotic AI</organization>
      <organizationUrl>https://qxotic.ai</organizationUrl>
    </developer>
  </developers>

  <modules>
    <!-- Core modules (order by dependency; the reactor topologically sorts by dependency anyway) -->
    <module>gguf</module>
    <module>json</module>
    <!-- JMH benchmarks for json; built with the reactor, never deployed (maven.deploy.skip). -->
    <module>json/benchmarks</module>
    <module>safetensors</module>
    <module>toknroll</module>
    <module>jota</module>
    <!-- jam: native (CMake) int8 GEMM backend, Java 25 (FFM). jinfer: LLM inference engine
         (multi-module), Java 25, depends on jam. Both raise maven.compiler.release above this
         parent's Java 11; neither subtree is dependency-closed, so build them from THIS root:
           mvn -pl jinfer/jinfer-server,jinfer/jinfer-bench -am package
         `-f jam` / `-f jinfer` only work once the outer modules are installed. -->
    <module>jam</module>
    <module>jinfer</module>
    <module>examples</module>
  </modules>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/qxoticai/qxotic.git</connection>
    <developerConnection>scm:git:https://github.com/qxoticai/qxotic.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/qxoticai/qxotic</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/qxoticai/qxotic/issues</url>
  </issueManagement>

  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/qxoticai/qxotic/actions</url>
  </ciManagement>

  <properties>
    <qxotic.version>${project.version}</qxotic.version>
    <!-- Publication is opt-in. Each supported or required transitive artifact overrides this.
         The release profile forwards it to central-publishing's skipPublishing, the plugin's own
         (and only) gate, so one switch decides what reaches Maven Central. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Which NOTICE a jar embeds; a component with third-party derivations points this at itself. -->
    <qxotic.notice.dir>${maven.multiModuleProjectDirectory}</qxotic.notice.dir>

    <!-- Build properties -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <maven.compiler.release>11</maven.compiler.release>

    <!-- Dependency versions -->
    <junit.version>6.1.3</junit.version>
    <opentest4j.version>1.3.0</opentest4j.version>
    <slf4j.version>2.0.18</slf4j.version>
    <jtokkit.version>1.1.0</jtokkit.version>
    <jmh.version>1.37</jmh.version>
    <jackson-databind.version>2.22.1</jackson-databind.version>
    <commons-compress.version>1.28.0</commons-compress.version>
    <commons-io.version>2.20.0</commons-io.version>

    <!-- Plugin versions -->
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.5</maven-failsafe-plugin.version>
    <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-help-plugin.version>3.5.2</maven-help-plugin.version>
    <maven-release-plugin.version>3.1.1</maven-release-plugin.version>
    <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <!-- default-lifecycle plugin; pinned so requirePluginVersions has nothing implicit -->
    <maven-site-plugin.version>3.12.1</maven-site-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.10.1</maven-javadoc-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
    <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
    <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
    <spotless-maven-plugin.version>3.3.0</spotless-maven-plugin.version>
    <google-java-format.version>1.27.0</google-java-format.version>
    <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
    <exec-maven-plugin.version>3.4.1</exec-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Logging -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <!-- Testing -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.opentest4j</groupId>
        <artifactId>opentest4j</artifactId>
        <version>${opentest4j.version}</version>
      </dependency>

      <!-- JMH for benchmarks -->
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-core</artifactId>
        <version>${jmh.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-generator-annprocess</artifactId>
        <version>${jmh.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- External dependencies -->
      <dependency>
        <groupId>com.knuddels</groupId>
        <artifactId>jtokkit</artifactId>
        <version>${jtokkit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson-databind.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>${commons-compress.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>${commons-io.version}</version>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>gguf</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>safetensors</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>json</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jota-core</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jota-memory</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jota-tensor</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jota-backend-panama</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jota-backend-c</artifactId>
        <version>${qxotic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
