<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jam</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>jam-native</artifactId>
  <packaging>jar</packaging>

  <name>JAM Native Backend</name>
  <description>Native CPU and Apple Metal backend for JAM.</description>

  <!-- The libjam (C) backend: NativeJAM + NativeLoader, the CMake-built native library bundled per
       os.arch, reached via JNI (default) or Panama (-Djam.native.binding=ffm). -->
  <properties>
    <maven.deploy.skip>false</maven.deploy.skip>
    <qxotic.notice.dir>${project.basedir}</qxotic.notice.dir>
    <native.cmake.executable>cmake</native.cmake.executable>
    <jam.native.skip>false</jam.native.skip>
    <jam.native.dir>dist/native</jam.native.dir>
    <!-- -Djam.native.skip=true reuses a pre-staged dist/native (the release profile forces it) -->
    <!-- -Djam.natives.check.skip=true bypasses the release gate (the canary, which only checks poms) -->
    <jam.natives.check.skip>false</jam.natives.check.skip>
    <!-- The C suite (ctest) follows surefire's switch: exec runs are not covered by -DskipTests. -->
    <skipTests>false</skipTests>
    <jam.native.tests.skip>${skipTests}</jam.native.tests.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- CMake stages this host's lib into dist/native (com/qxotic/jam/native/<os>-<arch>/...); as a
         resource it lands on the classpath, so NativeLoader finds + loads it exactly as from the fat jar.
         The release profile points jam.native.dir at dist/release, the tree scripts/natives.sh fills
         with every shipped platform - a tree no dev build writes to. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${jam.native.dir}</directory>
      </resource>
      <!-- An explicit list shadows the parent's resources; re-include the legal pair. -->
      <resource>
        <targetPath>META-INF</targetPath>
        <directory>${maven.multiModuleProjectDirectory}</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
      <resource>
        <targetPath>META-INF</targetPath>
        <directory>${qxotic.notice.dir}</directory>
        <includes>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- Build the native libjam via CMake before resources are processed. Skip with -Djam.native.skip=true. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>cmake-configure</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <skip>${jam.native.skip}</skip>
              <executable>${native.cmake.executable}</executable>
              <arguments>
                <argument>-S</argument>
                <argument>${project.basedir}</argument>
                <argument>-B</argument>
                <argument>${project.basedir}/build</argument>
                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>cmake-build</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <skip>${jam.native.skip}</skip>
              <executable>${native.cmake.executable}</executable>
              <arguments>
                <argument>--build</argument>
                <argument>${project.basedir}/build</argument>
                <argument>--target</argument>
                <argument>jam</argument>
                <argument>jam_test</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- The C suite sweeps every ISA cap this CPU supports (a CI runner sits on a lower
                 level than any dev box), so it runs wherever the library was just built. -->
            <id>ctest</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <skip>${jam.native.tests.skip}</skip>
              <executable>ctest</executable>
              <arguments>
                <argument>--test-dir</argument>
                <argument>${project.basedir}/build</argument>
                <argument>--output-on-failure</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          <!-- System.load is "restricted" on JDK 24+ -->
        </configuration>
        <executions>
          <!-- default-test runs the suite through the JNI backend (the default jam.native.binding); this
               second pass re-runs the SAME suite through the FFM/Panama backend, so both bindings and the
               jam.native.binding selector are exercised end-to-end. -->
          <execution>
            <id>test-ffm</id>
            <goals>
              <goal>test</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <argLine>@{argLine} --enable-native-access=ALL-UNNAMED -Djam.native.binding=ffm</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports-ffm</reportsDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Release: package the shipped set that scripts/natives.sh built into dist/release (linux-x86-64,
         windows-x86-64, darwin-aarch64) - never this host's cmake output. `natives.sh verify` refuses a
         missing, stale, replaced, or foreign library. -->
    <profile>
      <id>release</id>
      <properties>
        <jam.native.skip>true</jam.native.skip>
        <jam.native.tests.skip>true</jam.native.tests.skip>
        <jam.native.dir>dist/release</jam.native.dir>
      </properties>
      <build>
        <plugins>
          <!-- target/classes keeps whatever earlier builds copied there (the dev tree's host library
               included), so the release would package more than dist/release. Drop it first. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
              <execution>
                <id>drop-previously-copied-natives</id>
                <goals>
                  <goal>clean</goal>
                </goals>
                <phase>generate-resources</phase>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${project.build.outputDirectory}/com/qxotic/jam/native</directory>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-natives</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>generate-resources</phase>
                <configuration>
                  <skip>${jam.natives.check.skip}</skip>
                  <executable>${project.basedir}/scripts/natives.sh</executable>
                  <arguments>
                    <argument>verify</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
