<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jam</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>jam-scalar</artifactId>
  <packaging>jar</packaging>

  <name>JAM Scalar Backend</name>
  <description>Portable pure-Java scalar backend for JAM.</description>

  <properties>
    <maven.deploy.skip>false</maven.deploy.skip>
  </properties>

  <!-- Pure-Java backend: ScalarJAM, autovectorized gemm/gemv kernels that decode every supported dtype
       on the fly. No native code, no Vector API: the portable backend + the correctness reference. -->
  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- jam-core's TestPool, compiled from source (jam-core publishes no test-jar). -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-test-sources</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <sources>
                <source>${project.basedir}/../jam-core/src/testkit/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Build-time only: the GraalVM inlining annotations compile against name-matching stubs that
         are never published. Declared in a build profile (always on in this reactor) because the
         flatten plugin drops such dependencies from the released POM, so no consumer ever sees the
         com.qxotic:graalvm-annotations coordinate. -->
    <profile>
      <id>graalvm-annotations</id>
      <activation>
        <property>
          <name>!qxotic.noGraalvmAnnotations</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.qxotic</groupId>
          <artifactId>graalvm-annotations</artifactId>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
