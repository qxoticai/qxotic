<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jam</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>jam-vector</artifactId>
  <packaging>jar</packaging>

  <name>JAM Vector API Backend</name>
  <description>JAM backend accelerated by the Java Vector API.</description>

  <properties>
    <maven.deploy.skip>false</maven.deploy.skip>
  </properties>

  <!-- Java Vector API backend: VectorJAM + the per-dtype register-tiled SIMD kernels (relocated from
       jinfer, segment-based). Picks the tile shape from the CPU + JIT (-Djam.vector.tile). -->
  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-scalar</artifactId>
      <!-- the reference floor the SIMD kernels are checked against -->
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jam-native</artifactId>
      <!-- cross-backend parity also checks NativeJAM, when libjam loads -->
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- jam-core's TestPool, compiled from source (jam-core publishes no test-jar). -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-test-sources</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <sources>
                <source>${project.basedir}/../jam-core/src/testkit/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} --add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED -Djdk.incubator.vector.VECTOR_ACCESS_OOB_CHECK=0</argLine>
        </configuration>
        <executions>
          <!-- The parity suite again with libjam capped at the pre-VNNI tiers, which no dev box
               reaches on its own (CI runners and old clients do). A cap from another architecture
               drops to the portable kernels, so the runs are valid on ARM too. -->
          <execution>
            <id>native-avx2</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/JamBackendParityTest.java</include>
              </includes>
              <environmentVariables>
                <JAM_ISA>avx2</JAM_ISA>
              </environmentVariables>
            </configuration>
          </execution>
          <execution>
            <id>native-ssse3</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/JamBackendParityTest.java</include>
              </includes>
              <environmentVariables>
                <JAM_ISA>ssse3</JAM_ISA>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Build-time only: the GraalVM inlining annotations compile against name-matching stubs that
         are never published. Declared in a build profile (always on in this reactor) because the
         flatten plugin drops such dependencies from the released POM, so no consumer ever sees the
         com.qxotic:graalvm-annotations coordinate. -->
    <profile>
      <id>graalvm-annotations</id>
      <activation>
        <property>
          <name>!qxotic.noGraalvmAnnotations</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.qxotic</groupId>
          <artifactId>graalvm-annotations</artifactId>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
