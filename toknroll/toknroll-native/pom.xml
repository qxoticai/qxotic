<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>toknroll-aggregator</artifactId>
    <version>0.4.0</version>
  </parent>

  <artifactId>toknroll-native</artifactId>

  <name>Tok'n'Roll Native Library</name>
  <description>libtoknroll: toknroll as a shared library with a C API (include/toknroll.h), built with
    GraalVM Native Image, for Python, C and any language with a foreign function interface. Also the
    entry points libjinfer exports under the same header. The shared library is the artifact.</description>

  <properties>
    <!-- the C face needs the GraalVM SDK's class files, which are newer than toknroll's Java 11 floor -->
    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.testRelease>25</maven.compiler.testRelease>
    <toknroll.image.name>libtoknroll</toknroll.image.name>
    <!-- -O2, the builder's default, and on GraalVM CE the same code as -O3.
         What ships replaces it: Oracle GraalVM's PGO build, which compiles at -O3 the paths the profile ran -->
    <toknroll.image.opt>-O2</toknroll.image.opt>
    <!-- the collector: the serial one, with one survivor space. A loaded tokenizer's tables (Gemma 4's: 230 MB) then
         spend one young collection there on their way to the old generation, not up to fifteen, each a copy: 50 ms
         pauses that idled a batch's threads through its first few hundred MB. The Makefile says how to build with G1 -->
    <toknroll.image.gc>-H:MaxSurvivorSpaces=1</toknroll.image.gc>
    <toknroll.image.skip>false</toknroll.image.skip>
    <!-- the shims' C compiler, cc with GCC spellings; the windows profile swaps in cl, whose -D -I -c read the same -->
    <shim.cc>cc</shim.cc>
    <shim.cflags>-std=c11 -O2 -fPIC -Wall -Wextra -Wpedantic</shim.cflags>
    <shim.out>-o</shim.out>
    <shim.obj>.o</shim.obj>
    <shim.wrapper>--native-compiler-path=${project.basedir}/src/main/c/native-cc.sh</shim.wrapper>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-hf</artifactId>
    </dependency>
    <!-- the fast encoder of the tiktoken family; core finds it at run time -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-vector</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- hub references: jinfer's grammar, cache and downloads, one implementation for both products -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-hub</artifactId>
    </dependency>
    <dependency>
      <!-- the @CEntryPoint annotations and C type views; the image builder supplies them at run time -->
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>nativeimage</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- VectorWidth: the builder's own hosted API (CPUFeatureAccess) -->
      <groupId>org.graalvm.nativeimage</groupId>
      <artifactId>svm</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Build-time only: Errors' exception handlers are @Uninterruptible, as native image requires of
         them, an annotation the builder recognizes by name (com.oracle.svm.shared, where the 25.4
         builders keep it) and compiled here against jam's never-published stub. As in jam-vector: a
         profile, so the flattened, released POM never names the coordinate. -->
    <profile>
      <id>graalvm-annotations</id>
      <activation>
        <property>
          <name>!qxotic.noGraalvmAnnotations</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.qxotic</groupId>
          <artifactId>graalvm-annotations</artifactId>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <!-- The C face: the shim forwarding to the entry points, and the isolate it runs in. -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-shim</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <executable>${shim.cc}</executable>
                  <commandlineArgs>${shim.cflags} -DTOKNROLL_BUILD -I${project.basedir}/include -c ${project.basedir}/src/main/c/toknroll_shim.c ${shim.out}${project.build.directory}/toknroll_shim${shim.obj}</commandlineArgs>
                </configuration>
              </execution>
              <execution>
                <id>compile-isolate</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <executable>${shim.cc}</executable>
                  <commandlineArgs>${shim.cflags} -I${project.basedir}/include -c ${project.basedir}/src/main/c/toknroll_isolate.c ${shim.out}${project.build.directory}/toknroll_isolate${shim.obj}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <imageName>${toknroll.image.name}</imageName>
              <!-- true when libjinfer's build passes through: its own image carries this one's entry points -->
              <skip>${toknroll.image.skip}</skip>
              <sharedLibrary>true</sharedLibrary>
              <!-- Counterintuitively, the plugin maps false to the deprecated no-fallback flag and
                   true to no flag. This does not enable fallback images; GraalVM 25 has none. -->
              <fallback>true</fallback>
              <buildArgs>
                <!-- first, so the -H: options below that are experimental are unlocked -->
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>${toknroll.image.opt}</buildArg>
                <buildArg>${toknroll.image.gc}</buildArg>
                <buildArg>-H:NativeLinkerOption=${project.build.directory}/toknroll_shim${shim.obj}</buildArg>
                <buildArg>-H:NativeLinkerOption=${project.build.directory}/toknroll_isolate${shim.obj}</buildArg>
                <!-- the shim's toknroll_* symbols are the API; the wrapper adds them to GraalVM's export list -->
                <buildArg>${shim.wrapper}</buildArg>
                <!-- native-image runs the compiler in an environment of its own: name the wrapper's opt-in log -->
                <buildArg>-ENATIVE_CC_LOG</buildArg>
                <!-- and the soname the Makefile derives from the version -->
                <buildArg>-ENATIVE_SONAME</buildArg>
                <!-- a C library, not a JVM: no JNI_CreateJavaVM and friends in the export table -->
                <buildArg>-H:-JNIExportSymbols</buildArg>
                <!-- libstdc++ linked in when the image needs it (Oracle's G1 is C++): no GLIBCXX floor, no dependency -->
                <buildArg>-H:+StaticLibStdCpp</buildArg>
                <buildArg>-EMACOSX_DEPLOYMENT_TARGET</buildArg>
                <!-- the vector width and the curl transport come from native-image.properties: every image of the entry points needs them -->
                <!-- the image object stays here, for the static archive (static.sh) -->
                <buildArg>-H:TempDirectory=${project.build.directory}/svm</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Windows: the MSVC toolchain native-image requires there. No compiler wrapper: the shim's
           __declspec(dllexport) names are the export list and link.exe takes nothing else, so the
           wrapper's slot holds a flag the build has anyway. The DLL keeps Windows' name, no lib prefix. -->
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <toknroll.image.name>toknroll</toknroll.image.name>
        <shim.cc>cl</shim.cc>
        <shim.cflags>-nologo -std:c11 -O2 -W4</shim.cflags>
        <shim.out>-Fo</shim.out>
        <shim.obj>.obj</shim.obj>
        <shim.wrapper>-H:-JNIExportSymbols</shim.wrapper>
      </properties>
    </profile>
  </profiles>
</project>
