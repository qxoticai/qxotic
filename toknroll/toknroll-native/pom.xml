<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>toknroll-aggregator</artifactId>
    <version>0.3.1</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>toknroll-native</artifactId>
  <packaging>jar</packaging>

  <name>Tok'n'Roll Native Library</name>
  <description>libtoknroll: toknroll as a shared library with a C API (include/toknroll.h), built with
    GraalVM Native Image, for Python, C and any language with a foreign function interface. Also the
    entry points libjinfer exports under the same header. The shared library is the artifact.</description>

  <properties>
    <!-- the C face needs the GraalVM SDK's class files, which are newer than toknroll's Java 11 floor -->
    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.testRelease>25</maven.compiler.testRelease>
    <toknroll.image.name>libtoknroll</toknroll.image.name>
    <!-- -O2, the builder's default: -O3 bought 18% encode throughput for 11 MB of code (see the README) -->
    <toknroll.image.opt>-O2</toknroll.image.opt>
    <toknroll.image.march>compatibility</toknroll.image.march>
    <!-- the shims' C compiler, cc with GCC spellings; the windows profile swaps in cl, whose -D -I -c read the same -->
    <shim.cc>cc</shim.cc>
    <shim.cflags>-std=c11 -O2 -fPIC -Wall -Wextra -Wpedantic</shim.cflags>
    <shim.out>-o</shim.out>
    <shim.obj>.o</shim.obj>
    <shim.wrapper>--native-compiler-path=${project.basedir}/src/main/c/native-cc.sh</shim.wrapper>
    <graalvm.sdk.version>25.0.1</graalvm.sdk.version>
    <native-maven-plugin.version>0.10.6</native-maven-plugin.version>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-hf</artifactId>
    </dependency>
    <!-- hub references: jinfer's grammar, cache and downloads, one implementation for both products -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jinfer-hub</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the @CEntryPoint annotations and C type views; the image builder supplies them at run time -->
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>nativeimage</artifactId>
      <version>${graalvm.sdk.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <!-- The C face: the shim forwarding to the entry points, and the isolate it runs in. -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-shim</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <executable>${shim.cc}</executable>
                  <commandlineArgs>${shim.cflags} -DTOKNROLL_BUILD -I${project.basedir}/include -c ${project.basedir}/src/main/c/toknroll_shim.c ${shim.out}${project.build.directory}/toknroll_shim${shim.obj}</commandlineArgs>
                </configuration>
              </execution>
              <execution>
                <id>compile-isolate</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <executable>${shim.cc}</executable>
                  <commandlineArgs>${shim.cflags} -I${project.basedir}/include -c ${project.basedir}/src/main/c/toknroll_isolate.c ${shim.out}${project.build.directory}/toknroll_isolate${shim.obj}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${native-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <imageName>${toknroll.image.name}</imageName>
              <sharedLibrary>true</sharedLibrary>
              <!-- a fallback image would need a JDK at run time: a library that is not standalone is a failure -->
              <fallback>false</fallback>
              <buildArgs>
                <buildArg>${toknroll.image.opt}</buildArg>
                <buildArg>-march=${toknroll.image.march}</buildArg>
                <buildArg>-H:NativeLinkerOption=${project.build.directory}/toknroll_shim${shim.obj}</buildArg>
                <buildArg>-H:NativeLinkerOption=${project.build.directory}/toknroll_isolate${shim.obj}</buildArg>
                <!-- the shim's toknroll_* symbols are the API; the wrapper adds them to GraalVM's export list -->
                <buildArg>${shim.wrapper}</buildArg>
                <!-- native-image runs the compiler in an environment of its own: name the wrapper's opt-in log -->
                <buildArg>-ENATIVE_CC_LOG</buildArg>
                <!-- a C library, not a JVM: no JNI_CreateJavaVM and friends in the export table -->
                <buildArg>-H:-JNIExportSymbols</buildArg>
                <buildArg>-EMACOSX_DEPLOYMENT_TARGET</buildArg>
                <!-- hub fetches go through curl on the PATH (com.qxotic.fetch): the JDK client, and the
                     TLS stack it would bring, 18 MB, stay out of the image -->
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>-H:ServiceLoaderFeatureExcludeServiceProviders=com.qxotic.fetch.JdkTransport</buildArg>
                <!-- the image object stays here, for the static archive (static.sh) -->
                <buildArg>-H:TempDirectory=${project.build.directory}/svm</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Windows: the MSVC toolchain native-image requires there. No compiler wrapper: the shim's
           __declspec(dllexport) names are the export list and link.exe takes nothing else, so the
           wrapper's slot holds a flag the build has anyway. The DLL keeps Windows' name, no lib prefix. -->
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <toknroll.image.name>toknroll</toknroll.image.name>
        <shim.cc>cl</shim.cc>
        <shim.cflags>-nologo -std:c11 -O2 -W4</shim.cflags>
        <shim.out>-Fo</shim.out>
        <shim.obj>.obj</shim.obj>
        <shim.wrapper>-H:-JNIExportSymbols</shim.wrapper>
      </properties>
    </profile>
  </profiles>
</project>
