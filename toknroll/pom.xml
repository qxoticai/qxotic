<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>qxotic-parent</artifactId>
    <version>0.2.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>toknroll-aggregator</artifactId>
  <packaging>pom</packaging>
  <name>Tok'n'Roll Parent</name>
  <description>Customizable tiktoken-compatible and SentencePiece BPE tokenization for
    language models. Aggregator/parent POM; depend on the individual toknroll-* artifacts.</description>

  <modules>
    <module>toknroll-testkit</module>
    <module>toknroll-core</module>
    <module>toknroll-gguf</module>
    <module>toknroll-hf</module>
    <module>toknroll-incubator</module>
    <module>toknroll-benchmarks</module>
  </modules>

  <properties>
    <!-- Tok'n'Roll targets Java 11 bytecode -->
    <maven.compiler.release>11</maven.compiler.release>
    <maven.compiler.testRelease>17</maven.compiler.testRelease>
    <!-- toknroll-core binds surefire's skipTests to this knob (for reactor dependency-module
         runs). It defaults FROM the standard flag so -DskipTests keeps working, and can still
         be set directly: -Dtoknroll.skipDependentTests=true. -->
    <skipTests>false</skipTests>
    <toknroll.skipDependentTests>${skipTests}</toknroll.skipDependentTests>
    <surefire.baseExcludedGroups>local-external,network</surefire.baseExcludedGroups>
    <surefire.excludedGroups>${surefire.baseExcludedGroups}</surefire.excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-gguf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-hf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>toknroll-incubator</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
