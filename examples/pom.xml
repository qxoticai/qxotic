<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>qxotic-parent</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>examples</artifactId>
  <name>Quixotic Examples</name>
  <description>Example applications demonstrating the Quixotic AI stack. Not published to
    Maven Central.</description>

  <properties>
    <!-- Examples require Java 25 for Jota integration -->
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-tensor</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-gguf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>toknroll-hf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-backend-panama</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-backend-c</artifactId>
    </dependency>

    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-backend-hip</artifactId>
    </dependency>

    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-backend-metal</artifactId>
    </dependency>

    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-backend-cuda</artifactId>
    </dependency>

    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-backend-opencl</artifactId>
    </dependency>

    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-backend-mojo</artifactId>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.qxotic.jota.examples.demos.Mandelbrot</mainClass>
                </transformer>
                <!-- Every bundled jar's LICENSE and NOTICE is appended verbatim - never one picked:
                     toknroll-gguf's NOTICE carries third-party attribution (llama.cpp, ggml). -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
              </transformers>
              <!-- A shaded jar is one classpath jar: the JPMS descriptors of the modules it swallows
                   would declare modules that no longer exist, and the manifest is regenerated. -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
