<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jota-aggregator</artifactId>
    <version>0.2.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>jota-backend-c</artifactId>
  <name>Jota C Backend</name>
  <description>C backend for Jota tensor operations over a per-platform native library; the
    default backend on GraalVM Native Image. Not published to Maven Central.</description>

  <properties>
    <c.configure.extraArgs />
    <c.build.extraArgs />
    <native.dir>${project.basedir}/src/main/native</native.dir>
    <native.build.dir>${native.dir}/build</native.build.dir>
    <native.library.basename>jota_c</native.library.basename>
    <native.configure.extraArgs>${c.configure.extraArgs}</native.configure.extraArgs>
    <native.build.extraArgs>${c.build.extraArgs}</native.build.extraArgs>
    <native.copy.skip>false</native.copy.skip>
    <native.skip.tests>${skipTests.backend.c}</native.skip.tests>
    <native.skip.build>${skipNative.backend.c}</native.skip.build>
  </properties>

  <dependencies>
    <!-- Backends implement the core/memory API surface directly; declare, not inherit. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-tensor</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The jota-tensor suite and jota-memory's AbstractMemoryTest, compiled from source
             against this backend (jota-tensor publishes no test-jar). -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-test-sources</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <sources>
                <source>${project.basedir}/../jota-tensor/src/testkit/java</source>
                <source>${project.basedir}/../jota-memory/src/testkit/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${native.skip.tests}</skipTests>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
