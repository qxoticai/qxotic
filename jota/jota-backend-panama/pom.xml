<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qxotic</groupId>
    <artifactId>jota-aggregator</artifactId>
    <version>0.2.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>jota-backend-panama</artifactId>
  <name>jota-backend-panama</name>
  <description>Pure-Java backend for Jota tensor operations built on the FFM (Panama) API; the
    default backend on the JVM.</description>

  <dependencies>
    <!-- Backends implement the core/memory API surface directly; declare, not inherit. -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-tensor</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-tensor</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- the scanned tensor suite extends jota-memory's AbstractMemoryTest; test-jar deps are
         not transitive, so the memory test-jar must be declared here explicitly -->
    <dependency>
      <groupId>com.qxotic</groupId>
      <artifactId>jota-memory</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${skipTests.backend.panama}</skipTests>
          <dependenciesToScan>
            <dependency>com.qxotic:jota-tensor:test-jar:tests:${project.version}</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
